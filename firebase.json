{
  "firestore": [
    {
      "database": "ai-studio-android-apkdirec-94ade64d-cd60-4368-abc6-2261d83b2f94",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "public": "admin-web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    },
    "ui": {
      "enabled": false
    }
  }
}
